---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug } = Astro.params;

const post = slug ? await getEntry('blog', slug) : undefined;

if (!post) {
  return Astro.rewrite('/404');
}

const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={`${post.data.title} — Panhinda Blog`} description={post.data.description}>
  <a class="back-link" href="/">&larr; Back to all posts</a>

  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">{formattedDate} &middot; by {post.data.author}</p>
      {post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => <li class="tag">#{tag}</li>)}
        </ul>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
